# Copy to .env.local and adjust. Every value shown is the default.

# --- Adapters (§2) -----------------------------------------------------------
# The SQLite file. Without it, `next dev` runs on mock adapters seeded with
# Ada, Ben and Cy (password `password`), and production refuses to start.
# Create the schema with `npm run db:migrate`, then `npm run db:seed`.
# DATABASE_PATH=./data/app.db
# `real` or `mock`. Wins over everything else; production refuses `mock`.
# ADAPTERS=

#region observability
# --- Observability (§8, ADR 0015) ---------------------------------------------
# otlp | console | none. `none` keeps trace ids, so error references work.
OTEL_TRACES_EXPORTER=none
# otlp | console | none
OTEL_METRICS_EXPORTER=none
# otlp | none (pino already writes NDJSON to stdout)
OTEL_LOGS_EXPORTER=none
# Milliseconds.
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_METRIC_EXPORT_TIMEOUT=30000
# error | warn | info | debug | trace | silent.
# Default: info in production, debug in dev, silent under test.
# LOG_LEVEL=
OTEL_SERVICE_NAME=next-ddd-starter
# Per the OpenTelemetry spec, read by NodeSDK and the OTLP exporters as-is:
# OTEL_RESOURCE_ATTRIBUTES=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# Default parentbased_always_on. Sampling is never set in code.
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=
# Read by Next itself.
# NEXT_OTEL_VERBOSE=
# NEXT_OTEL_FETCH_DISABLED=
# Not supported: startup fails. Use OTEL_TRACES_EXPORTER=none instead.
# OTEL_SDK_DISABLED=
#endregion observability
